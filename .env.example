# Gemini API 密钥(可选,其他选项见下方)
GOOGLE_GENERATIVE_AI_API_KEY="insert-secret-key-here"

# Anthropic API 密钥(可选,其他选项见上方/下方)
ANTHROPIC_API_KEY="insert-secret-key-here"

# OpenAI API 密钥(可选,其他选项见上方)
OPENAI_API_KEY="insert-secret-key-here"

# OpenAI 自定义域名(可选,用于代理/中转服务,默认 https://api.openai.com/v1)
# OPENAI_BASE_URL="https://your-custom-domain.com/v1"

# Langfuse 可观测性(可选,仅 06.07 练习需要)
# LANGFUSE_PUBLIC_KEY="pk-lf-..."
# LANGFUSE_SECRET_KEY="sk-lf-..."
# LANGFUSE_BASE_URL="https://cloud.langfuse.com"
